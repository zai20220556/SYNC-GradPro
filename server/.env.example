# MySQL connection string (for example from Aiven). Looks like: mysql://USER:PASSWORD@HOST:PORT/defaultdb
DATABASE_URL="mysql://USER:PASSWORD@HOST:PORT/defaultdb"
# Any long random text. Keep it secret.
JWT_SECRET="change-me-to-a-long-random-string"
CLIENT_URL="http://localhost:5173"
PORT=4000
# Cloudinary (free account) for image and document uploads. Leave empty to run without uploads.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
